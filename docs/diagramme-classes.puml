@startuml RescueNet_Moyen
title RescueNet — Diagramme de classes (entités, enums, sous-objets)

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam dpi 150
hide empty members

' =====================================================
' 1. EMERGENCY-SERVICE  (Java · PostgreSQL)
' =====================================================
package "1 - emergency-service  (Java · PostgreSQL)" #FFF1E0 {

  class Mission <<Entity>> {
    +id : String
    +status : MissionStatus
    +callerPhone : String
    +nationalId : String
    +patientId : String
    +age : Integer
    +latitude : double
    +longitude : double
    +symptoms : String
    --triage--
    +severity : String
    +score : Double
    +specialty : String
    --hôpital--
    +hospitalId : Integer
    +hospitalName : String
    +reservationId : String
    --ambulance--
    +ambulanceId : String
    +etaMinutes : Double
    --suivi--
    +failureReason : String
    +createdAt : Instant
    +updatedAt : Instant
  }

  enum MissionStatus {
    CREATED
    TRIAGED
    BED_RESERVED
    DISPATCHED
    ON_SCENE
    TRANSPORTING
    COMPLETED
    FAILED
  }

  class EmergencyRequest <<DTO>> {
    +callerPhone : String
    +nationalId : String
    +symptoms : List<String>
    +age : Integer
  }

  class Location <<sous-objet>> {
    +lat : Double
    +lng : Double
  }

  class Vitals <<sous-objet>> {
    +heartRate : Integer
    +spo2 : Integer
    +systolicBP : Integer
    +consciousness : String
    +painLevel : Integer
  }

  Mission --> MissionStatus
  EmergencyRequest *-- Location
  EmergencyRequest *-- Vitals
  EmergencyRequest ..> Mission : crée
}

' =====================================================
' 2. PATIENT-RECORD-SERVICE  (NodeJS · MongoDB)
' =====================================================
package "2 - patient-record-service  (NodeJS · MongoDB)" #E8F6EA {

  class Patient <<Document>> {
    +_id : ObjectId
    +nationalId : String
    +fullName : String
    +age : Number
    +gender : Gender
    +bloodType : String
    +allergies : String[]
    +chronicConditions : String[]
    +medications : String[]
    +temporary : Boolean
  }

  class Contact <<sous-document>> {
    +name : String
    +phone : String
  }

  class Intervention <<sous-document>> {
    +missionId : String
    +severity : String
    +hospitalName : String
    +symptoms : String[]
    +date : Date
  }

  enum Gender {
    M
    F
    UNKNOWN
  }

  Patient "1" *-- "0..1" Contact : emergencyContact
  Patient "1" *-- "0..*" Intervention : interventions
  Patient --> Gender
}

' =====================================================
' 3. TRIAGE-AI-SERVICE  (Python · MySQL)
' =====================================================
package "3 - triage-ai-service  (Python · MySQL)" #E6EEF8 {

  class TriageRecord <<Entity · triage_records>> {
    +id : int
    +created_at : datetime
    +severity : Severity
    +score : float
    +specialty : Specialty
    +request : JSON
  }

  class TriageRequest <<DTO>> {
    +age : int
    +symptoms : list[str]
    +medicalHistory : list[str]
  }

  class "Vitals" as TriageVitals <<sous-objet>> {
    +heartRate : int
    +spo2 : int
    +systolicBP : int
    +consciousness : Consciousness
    +painLevel : int
  }

  enum Severity {
    VERT
    ORANGE
    ROUGE
  }

  enum Consciousness {
    ALERT
    VOICE
    PAIN
    UNRESPONSIVE
  }

  enum Specialty {
    CARDIOLOGY
    NEUROLOGY
    TRAUMA
    PULMONOLOGY
    GENERAL
  }

  TriageRequest *-- TriageVitals
  TriageVitals --> Consciousness
  TriageRecord --> Severity
  TriageRecord --> Specialty
  TriageRequest ..> TriageRecord : donne
}

' =====================================================
' 4. HOSPITAL-SERVICE  (C# · SQL Server)
' =====================================================
package "4 - hospital-service  (C# · SQL Server)" #F2E9FB {

  class Hospital <<Entity>> {
    +Id : int
    +Name : string
    +City : string
    +Latitude : double
    +Longitude : double
    +Specialties : string
    +TotalBeds : int
    +AvailableBeds : int
  }

  class BedReservation <<Entity>> {
    +Id : Guid
    +HospitalId : int
    +MissionId : string
    +Specialty : string
    +Severity : string
    +Status : ReservationStatus
    +CreatedAt : DateTime
  }

  enum ReservationStatus {
    RESERVED
    ADMITTED
    RELEASED
  }

  Hospital "1" -- "0..*" BedReservation : contient
  BedReservation --> ReservationStatus
}

' =====================================================
' 5. DISPATCH-SERVICE  (Go · Redis)
' =====================================================
package "5 - dispatch-service  (Go · Redis)" #E3F7F9 {

  class Ambulance <<struct>> {
    +ID : string
    +Plate : string
    +Status : AmbulanceStatus
    +MissionID : string
    +Position : Point
  }

  class DispatchMission <<struct>> {
    +MissionID : string
    +AmbulanceID : string
    +Severity : string
    +Phase : MissionPhase
    +Pickup : Point
    +Hospital : Point
  }

  class Point <<sous-objet>> {
    +Lat : float64
    +Lng : float64
  }

  enum AmbulanceStatus {
    AVAILABLE
    ASSIGNED
  }

  enum MissionPhase {
    TO_SCENE
    ON_SCENE
    TO_HOSPITAL
    ARRIVED
    DONE
  }

  Ambulance *-- Point : Position
  DispatchMission *-- "2" Point : Pickup + Hospital
  Ambulance --> AmbulanceStatus
  DispatchMission --> MissionPhase
  DispatchMission "0..1" --> "1" Ambulance : utilise
}

' =====================================================
' RELATIONS ENTRE SERVICES  (références logiques, pas de clé étrangère)
' =====================================================
Mission ..> Patient : patientId
Mission ..> TriageRecord : severity, specialty
Mission ..> BedReservation : reservationId
Mission ..> Hospital : hospitalId
Mission ..> Ambulance : ambulanceId
Mission ..> DispatchMission : même missionId
Intervention ..> Mission : missionId

note bottom of Mission
  Chaque service a sa propre base de données :
  les liens entre services sont des identifiants
  (patientId, reservationId, ambulanceId...),
  jamais des clés étrangères.
  Severity et Specialty sont échangées en texte (JSON)
  entre triage-ai et hospital : pas de code partagé.
end note



@enduml
