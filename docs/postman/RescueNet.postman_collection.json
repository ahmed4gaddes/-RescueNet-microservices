{
  "info": {
    "name": "RescueNet",
    "description": "Tests des API via la Gateway (JWT Keycloak). Lancer d'abord une connexion, puis les requêtes. Dossier 3 : contrôle des rôles.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "keycloakUrl",
      "value": "http://localhost:8180"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "missionId",
      "value": ""
    },
    {
      "key": "patientId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Opérateur",
      "item": [
        {
          "name": "Connexion OPERATEUR (operateur)",
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "rescuenet-cli"
                },
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "username",
                  "value": "operateur"
                },
                {
                  "key": "password",
                  "value": "operateur123"
                }
              ]
            },
            "url": "{{keycloakUrl}}/realms/rescuenet/protocol/openid-connect/token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('JWT reçu', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('token', j.access_token);",
                  "const roles = JSON.parse(atob(j.access_token.split('.')[1])).realm_access.roles;",
                  "pm.test('Rôle OPERATEUR présent', () => pm.expect(roles).to.include('OPERATEUR'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sans jeton → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/emergencies",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Créer une urgence",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/emergencies",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"callerPhone\": \"+21698123456\",\n  \"nationalId\": \"12345678\",\n  \"age\": 58,\n  \"location\": {\n    \"lat\": 36.806,\n    \"lng\": 10.18\n  },\n  \"symptoms\": [\n    \"douleur thoracique intense\",\n    \"sueurs froides\"\n  ],\n  \"vitals\": {\n    \"heartRate\": 128,\n    \"spo2\": 88,\n    \"systolicBP\": 95,\n    \"consciousness\": \"ALERT\",\n    \"painLevel\": 9\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 201', () => pm.response.to.have.status(201));",
                  "const m = pm.response.json();",
                  "pm.collectionVariables.set('missionId', m.missionId);",
                  "pm.collectionVariables.set('patientId', m.patientId);",
                  "pm.test('Triage ROUGE', () => pm.expect(m.triage.severity).to.eql('ROUGE'));",
                  "pm.test('Hôpital et ambulance affectés', () => { pm.expect(m.hospital.name).to.be.a('string'); pm.expect(m.ambulance.id).to.be.a('string'); });",
                  "pm.test('Statut DISPATCHED', () => pm.expect(m.status).to.eql('DISPATCHED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Suivre la mission",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/emergencies/{{missionId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', () => pm.response.to.have.status(200));",
                  "pm.test('Statut valide', () => pm.expect(['DISPATCHED','ON_SCENE','TRANSPORTING','COMPLETED']).to.include(pm.response.json().status));"
                ]
              }
            }
          ]
        },
        {
          "name": "Liste des missions",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/emergencies",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tableau', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Patients (lecture)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/patients",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Dossier patient",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/patients/{{patientId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Hôpitaux",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/hospitals",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', () => pm.response.to.have.status(200));",
                  "pm.test('Au moins un hôpital', () => pm.expect(pm.response.json().length).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ambulances",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/dispatch/ambulances",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Position de l'ambulance de la mission",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/dispatch/missions/{{missionId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', () => pm.response.to.have.status(200));",
                  "pm.test('Phase connue', () => pm.expect(['TO_SCENE','TO_HOSPITAL','DONE']).to.include(pm.response.json().phase));"
                ]
              }
            }
          ]
        }
      ]
    },
